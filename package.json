{
  "name": "wallp",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w @wallp/mobile --",
    "android": "npm run android -w @wallp/mobile",
    "web": "npm run web -w @wallp/mobile",
    "api:dev": "npm run dev -w @wallp/api",
    "db:migrate": "npm run migrate -w @wallp/api",
    "db:seed": "npm run seed -w @wallp/api --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @wallp/api",
    "build:api": "npm run build -w @wallp/api",
    "export:android": "npm run export:android -w @wallp/mobile",
    "export:web": "npm run export:web -w @wallp/mobile"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
