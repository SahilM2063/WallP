{
  "name": "@wallp/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:android": "expo export --platform android --output-dir dist/android --max-workers 2",
    "export:web": "expo export --platform web --output-dir dist/web --max-workers 2",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
